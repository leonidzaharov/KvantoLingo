// ============================================================
// Prisma Schema — Геймифицированная платформа «Кванториум»
// БД: PostgreSQL (Supabase в проде, локально — pg в Docker).
// Подключение настраивается через DATABASE_URL/DIRECT_URL,
// см. prisma.config.ts и src/lib/db.ts.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ДОМЕН 1: Пользователи и учебный контент
// ============================================================

/// Направление обучения — первый шаг выбора на экране входа.
enum GroupTrack {
  intro // вводный
  advanced // углублённый
  project // проектный
}

/// Учебная группа (например «it-01»). Экран входа: направление → группа
/// → ученик. Управляется наставником в /admin/groups.
model Group {
  id    Int        @id @default(autoincrement())
  name  String     @unique
  track GroupTrack

  students User[]
}

/// Профиль ученика. Аутентификация через 4-значный PIN-код.
/// isAdmin = наставник: видит админку (/admin) и правит контент.
model User {
  id             String    @id @default(uuid())
  name           String
  pinHash        String
  isAdmin        Boolean   @default(false)
  groupId        Int? // null = «без группы» (новенькие и наставники)
  totalXp        Int       @default(0)
  level          Int       @default(1)
  currency       Int       @default(0)
  lastActiveDate DateTime? // последний вход/активность — «кто давно не появлялся»
  createdAt      DateTime  @default(now())

  // Связи
  group            Group?               @relation(fields: [groupId], references: [id])
  achievements     UserAchievement[]
  lessonProgress   UserLessonProgress[]
  studiedResources UserResource[]
}

/// Категория уроков — модуль программы (например: «Scratch», «Python»).
/// track привязывает модуль к направлению: ученик видит только модули
/// направления своей группы (наставник — все). Существующие категории
/// HTML/JS/Scratch — вводные, поэтому default(intro).
model Category {
  id      Int        @id @default(autoincrement())
  name    String
  icon    String?
  track   GroupTrack @default(intro)
  lessons Lesson[]
}

/// Отдельный урок с вопросами/заданиями в формате JSON
model Lesson {
  id         Int      @id @default(autoincrement())
  categoryId Int
  title      String
  content    String   // JSON-строка с вопросами и заданиями
  xpReward   Int      @default(10)
  coinReward Int      @default(5) // монет за первое ПОЛНОЕ прохождение (тратятся офлайн у наставника)
  sortOrder  Int      @default(0)

  category Category             @relation(fields: [categoryId], references: [id])
  progress UserLessonProgress[]
}

/// Прогресс ученика по уроку. answeredCount/totalQuestions даёт реальный %
/// для прогресс-бара на дашборде. isCompleted фиксируется один раз и
/// блокирует повторное начисление XP за тот же урок.
model UserLessonProgress {
  userId         String
  lessonId       Int
  answeredCount  Int       @default(0)
  wrongAttempts  Int       @default(0)
  totalQuestions Int       @default(0)
  isCompleted    Boolean   @default(false)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
}

// ============================================================
// ДОМЕН 2: Достижения
// ============================================================

/// Справочник достижений (ачивок). `code` — стабильный идентификатор,
/// под которым на достижение ссылается код приложения (см. lib/achievements).
/// Числовой `id` остаётся PK, но не годится для ссылок из кода.
model Achievement {
  id             Int     @id @default(autoincrement())
  code           String  @unique
  title          String
  description    String
  icon           String?
  targetValue    Int     // Целевое значение для разблокировки
  rewardCurrency Int     @default(0)
  isHidden       Boolean @default(false)

  users UserAchievement[]
}

/// Связующая таблица «Пользователь ↔ Достижение» с прогрессом
model UserAchievement {
  userId        String
  achievementId Int
  progress      Int      @default(0)
  isUnlocked    Boolean  @default(false)
  unlockedAt    DateTime?

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
}

// ============================================================
// ДОМЕН 3: Безопасность входа
// ============================================================

/// Журнал попыток логина для rate-limit'а 4-значного PIN.
/// authorize() считает count неудачных за последние 15 минут — если ≥ 5,
/// отказ независимо от верности PIN. Индекс по (userId, attemptedAt)
/// держит COUNT(*) быстрым даже на десятках тысяч записей.
/// FK на User НЕ ставим: попытки с несуществующим userId сюда не пишутся
/// (см. src/auth.ts) — но если когда-то начнём логировать и enumeration,
/// FK помешает каскадному удалению user'а.
model LoginAttempt {
  id          Int      @id @default(autoincrement())
  userId      String
  succeeded   Boolean
  attemptedAt DateTime @default(now())

  @@index([userId, attemptedAt])
}

// ============================================================
// ДОМЕН 4: Блок «Интересное» (внеурочные материалы)
// ============================================================

/// Тип материала — определяет, как карточка рендерится на /interesting.
enum ResourceType {
  scratch // встроенный проект Scratch (url = ID проекта из ссылки)
  video // встроенное видео YouTube (url = ID видео после v=)
  article // внешняя ссылка (url = полный https-адрес)
  note // текстовый совет наставника (текст в body)
}

/// Материал блока «Интересное». Раньше был статичным списком в коде
/// (src/app/(main)/interesting/resources.ts) — перенесён в БД, чтобы
/// добавлять/править через будущую админку, а не правкой файлов.
model Resource {
  id          Int          @id @default(autoincrement())
  type        ResourceType
  title       String
  description String? // короткое пояснение под заголовком
  url         String? // смысл зависит от type (см. enum выше)
  body        String? // текст для type = note
  coinReward  Int          @default(1) // монет за «Изучил» (разово; обычно 1/2/3 по типу)
  sortOrder   Int          @default(0) // порядок отображения (меньше — выше)
  createdAt   DateTime     @default(now())

  studiedBy UserResource[]
}

/// Отметка «ученик изучил материал». Уникальность пары гарантирует,
/// что монеты за материал начисляются не больше одного раза.
model UserResource {
  userId     String
  resourceId Int
  studiedAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
}
